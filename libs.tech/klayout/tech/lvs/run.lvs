# See: https://www.klayout.de/doc-qt5/manual/lvs_device_extractors.html
# Run mode {deep(default), flat}
if $run_mode == 'flat'
    puts("Setting running mode => flat")
    flat
else
    puts("Setting running mode => deep")
    deep          # Hierarchical extraction
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Define Top Cell
if $input 
    if $top_cell
        source($input, $top_cell)
    else
        source($input)
    end
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Extract Netlist Only
if $netlist_only
    NET_ONLY = true
else
    NET_ONLY = false
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Output report(lvsdb) file
if $report
    report_lvs($report)
else
    report_lvs    # LVS report window
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Extract Netlist Only
if $ignore_top_ports_mismatch
    IGNORE_TOP_PORTS_MISMATCH = true
else
    IGNORE_TOP_PORTS_MISMATCH = false
end
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Spice net format {simulation(default), lvs}
if $spice_format == 'lvs'
    puts("Setting spice net format => lvs")
    spice_format = 'lvs'
else
    puts("Setting spice net format => simulation")
    spice_format = 'simulation'
end
# ----- ------ ----- ----- ------ ----- ----- ------ -----

skip_warnings = false

NO_COMBINE = $no_combine
puts "no combine_devices (no_combine=true)" if NO_COMBINE

STRICT_STDCEL_PINS = $strict_stdcel_pins
puts "Unset equivalent_pins for STDCELL (strict_stdcel_pins=true)" if STRICT_STDCEL_PINS

