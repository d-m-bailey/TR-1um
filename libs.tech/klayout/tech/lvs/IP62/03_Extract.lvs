if $spice_format == 'lvs'
  MOS_MODEL = {
      'NMOS' => 'NMOS',
      'PMOS' => 'PMOS',
      'NESD' => 'NMOSE',
      'PESD' => 'PMOS',
  }.freeze
else # $spice_format == 'simulaion'
  MOS_MODEL = {
      'NMOS' => 'NMOS',
      'PMOS' => 'PMOS',
      'NESD' => 'MNE',
      'PESD' => 'MPE',
  }.freeze
end

# MOS extraction 5V CMOS
#
# extract_devices(mos4("PMOS" ),
# extract_devices(mos4("PMOS", XMOS4Transistor),
extract_devices(mos4(MOS_MODEL['PMOS'], XMOS4Transistor),
                            { "SD" => (AAMP - SGG),     # S/D region
                              "G"  => (AAMP & SGG),     # Channel region
                              "W"  => (NWMP),           # Backgate region
                              "tS" => (SDMP),           # Terminal: Source
                              "tD" => (SDMP),           # Terminal: Drain
                              "tG" => (SGG),            # Terminal: Gate
                              "tB" => (NWMP) })         # Terminal: Backgate
#
# tolerance("PMOS", "W", :relative => 0.01)               # 1% tolerance
# tolerance("PMOS", "L", :relative => 0.0)                # 0% tolerance
tolerance(MOS_MODEL['PMOS'], "W", :relative => 0.01)    # 1% tolerance
tolerance(MOS_MODEL['PMOS'], "L", :relative => 0.0)     # 0% tolerance
#
# extract_devices(mos4("NMOS" ),
# extract_devices(mos4("NMOS", XMOS4Transistor),
extract_devices(mos4(MOS_MODEL['NMOS'], XMOS4Transistor),
                            { "SD" => (AAMN - SGG),     # S/D region
                              "G"  => (AAMN & SGG),     # Channel region
                              "W"  => (BULK),           # Backgate region
                              "tS" => (SDMN),           # Terminal: Source
                              "tD" => (SDMN),           # Terminal: Drain
                              "tG" => (SGG),            # Terminal: Gate
                              "tB" => (BULK) })         # Terminal: Backgate
#
# tolerance("NMOS", "W", :relative => 0.01)               # 1% tolerance
# tolerance("NMOS", "L", :relative => 0.0)                # 0% tolerance
tolerance(MOS_MODEL['NMOS'], "W", :relative => 0.01)    # 1% tolerance
tolerance(MOS_MODEL['NMOS'], "L", :relative => 0.0)     # 0% tolerance
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# MOS extraction 5V CMOS for ESD only NMOS is special
#
# extract_devices(mos4("PMOS" ),
# extract_devices(mos4("PMOS", XMOS4Transistor),
extract_devices(mos4(MOS_MODEL['PESD'], XMOS4Transistor),
                            { "SD" => (AAPE - SGG),     # S/D region
                              "G"  => (AAPE & SGG),     # Channel region
                              "W"  => (NWMP),           # Backgate region
                              "tS" => (SDPE),           # Terminal: Source
                              "tD" => (SDPE),           # Terminal: Drain
                              "tG" => (SGG),            # Terminal: Gate
                              "tB" => (NWMP) })         # Terminal: Backgate

# tolerance("PMOS", "W", :relative => 0.01)               # 1% tolerance
# tolerance("PMOS", "L", :relative => 0.0)                # 0% tolerance
tolerance(MOS_MODEL['PESD'], "W", :relative => 0.01)    # 1% tolerance
tolerance(MOS_MODEL['PESD'], "L", :relative => 0.0)     # 0% tolerance

# extract_devices(mos4("NMOSE" ),
# extract_devices(mos4("NMOSE", XMOS4Transistor),
extract_devices(mos4(MOS_MODEL['NESD'], XMOS4Transistor),
                            { "SD" => (AANE - SGG),     # S/D region
                              "G"  => (AANE & SGG),     # Channel region
                              "W"  => (BULK),           # Backgate region
                              "tS" => (SDNE),           # Terminal: Source
                              "tD" => (SDNE),           # Terminal: Drain
                              "tG" => (SGG),            # Terminal: Gate
                              "tB" => (BULK) })         # Terminal: Backgate
#
# tolerance("NMOSE", "W", :relative => 0.01)              # 1% tolerance
# tolerance("NMOSE", "L", :relative => 0.0)               # 0% tolerance
tolerance(MOS_MODEL['NESD'], "W", :relative => 0.01)    # 1% tolerance
tolerance(MOS_MODEL['NESD'], "L", :relative => 0.0)     # 0% tolerance
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# DIODE extraction
#
extract_devices(diode("DP", MDiode),
                            { "P"  => (AADP),           # P region
                              "N"  => (NWMP),           # N region
                              "tA" => (AADP),           # Terminal: Anode
                              "tC" => (NWMP) })         # Terminal: Cathode
#
tolerance("DP", "A", :relative => 0.0)                  # 0% tolerance
tolerance("DP", "P", :relative => 0.0)                  # 0% tolerance
tolerance("DP", "m", :relative => 0.0)                  # 0% tolerance
#
extract_devices(diode("DN", MDiode),                            # Floating Protection
                            { "P"  => (BULK),           # P region
                              "N"  => (AADN),           # N region
                              "tA" => (BULK),           # Terminal: Anode
                              "tC" => (AADN) })         # Terminal: Cathode
#
tolerance("DN", "A", :relative => 0.0)                  # 0% tolerance
tolerance("DN", "P", :relative => 0.0)                  # 0% tolerance
tolerance("DP", "m", :relative => 0.0)                  # 0% tolerance
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Resistor extraction
#
extract_devices(resistor("F_RS", 1, LWResistor),
                    { "R"  => (RSB),                    # Resistance Layer`
                      "C"  => (RSC),                    # Contact Layer
                      "tA" => (RSC),                    # Terminal: A
                      "tB" => (RSC) })                  # Terminal: B
#
tolerance("F_RS", "W", :relative => 0.01)               # 1% tolerance
tolerance("F_RS", "L", :relative => 0.01)               # 1% tolerance
ignore_parameter("F_RS", "R")                           # ignore "R" for comparison
#
extract_devices(resistor_with_bulk("F_RR", 1, LWResistorWithBulk),
                    { "R"  => (RRB),                    # Resistance Layer`
                      "C"  => (ARC),                    # Contact Layer
                      "W"  => (NWRR),                   # NWELL plate
                      "tA" => (ARC),                    # Terminal: A
                      "tB" => (ARC),                    # Terminal: B
                      "tW" => (NWRR) })                 # Terminal: NWELL
#
tolerance("F_RR", "W", :relative => 0.01)               # 1% tolerance
tolerance("F_RR", "L", :relative => 0.01)               # 1% tolerance
ignore_parameter("F_RR", "R")                           # ignore "R" for comparison
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
equivalent_pins("F_RS", "A", "B")
equivalent_pins("F_RR", "A", "B")
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Capacitor extraction
#
extract_devices(capacitor_with_bulk("F_CSIO", 0.6e-15, LWCapacitorWithBulk),
                    { "P1" => (SGG),                    # Top plate
                      "P2" => (AACC),                   # Bottom plate
                      "W"  => (NWCS),                   # Bulk plate
                      "tA" => (SGG),                    # Terminal: A
                      "tB" => (NWCS),                   # Terminal: B
                      "tW" => (BULK) })                 # Terminal: BULK

# tolerance("F_CSIO", "C", :relative => 0.01)             # 1% tolerance
tolerance("F_CSIO", "A", :relative => 0.01)             # 1% tolerance
tolerance("F_CSIO", "P", :relative => 0.01)             # 1% tolerance
ignore_parameter("F_CSIO", "C")                         # ignore "C" for comparison
ignore_parameter("F_CSIO", "W")                         # ignore "W" for comparison
ignore_parameter("F_CSIO", "L")                         # ignore "L" for comparison
